---
import { type CollectionEntry, render } from "astro:content";
import getReadingTime from "reading-time";
import Contents from "../components/Contents.astro";
import TOC from "../components/TOC.astro";
import Layout from "./Layout.astro";
import { Image } from "astro:assets";

interface Props {
	post: CollectionEntry<"posts">;
}

const { post } = Astro.props;

const { Content, headings } = await render(post);
const titleSlug = post.data.title.toLowerCase().replaceAll(/\s/g, "-");
---

<Layout title={post.data.title} item={post} >
    <Contents>
      <article>
        <TOC headings={headings} title={post.data.includeTitleInTOC ? post.data.title : undefined } />

        { post.data.image &&
          <Image class="cover" src={post.data.image} alt={post.data.imageAlt ?? post.data.title} loading="lazy" />
        }
        <small><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString()}</time> &middot; {getReadingTime(post.body!).text}</small>
        <h1 class="title" id={titleSlug}>{post.data.title}</h1>
        <h3 class="description">{post.data.description}</h3>
        <Content />
      </article>
      <script src="https://giscus.app/client.js"
              data-repo="chabad360/mendelgreenberg.com"
              data-repo-id="R_kgDOSBEpeg"
              data-category="Posts"
              data-category-id="DIC_kwDOSBEpes4C6uHC"
              data-mapping="pathname"
              data-strict="0"
              data-reactions-enabled="1"
              data-emit-metadata="0"
              data-input-position="top"
              data-lang="en"
              data-loading="lazy"
              crossorigin="anonymous"
              data-theme="preferred_color_scheme"
              async>
      </script>
    </Contents>
</Layout>

<style>
  .cover {
    border: 1px solid var(--color);
    border-radius: 1rem;
    max-height: 16rem;
  }

  .title {
    font-family: var(--font-sans);
    font-weight: 400;
    text-align: left;
    font-size: 24pt;
    margin-bottom: 0.2rem;
  }

  .description {
    font-style: italic;
    font-family: var(--font-serif);
    margin-top: 0;
  }

  small {
    display: block;
    margin-top: 0.5rem;
    margin-bottom: -0.8rem;
  }
</style>
