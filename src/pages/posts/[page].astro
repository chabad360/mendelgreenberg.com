---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import type { PaginateFunction } from "astro";
import getReadingTime from "reading-time";
import Contents from "../../components/Contents.astro";
import ItemData from "../../components/ItemData.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths({
	paginate,
}: {
	paginate: PaginateFunction;
}) {
	const posts = (await getCollection("posts"))
		.filter((post) => (import.meta.env.PROD ? post.data.publish : true))
		.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

	return paginate(posts, { pageSize: 7 });
}

const { page } = Astro.props;
---
<Layout title={`Posts - Page ${page.currentPage}`}>
    <Contents>
        <h1>Posts</h1>
        <ul>
            {page.data.map((post) =>
            <li>
              <a href={post.id}>
                <article class="button">
                  <div>
                    <ItemData item={post} />
                    <hgroup>
                      <h2>{post.data.title}</h2>
                      <p>{post.data.description}</p>
                    </hgroup>
                  </div>
                  { post.data.image &&
                    <Image src={post.data.image} alt={post.data.imageAlt ?? post.data.title} loading="lazy" />
                  }
                </article>
              </a>
            </li>
            )}
        </ul>
        <nav>
          <div>
            {page.url.first ? <a href={page.url.first}>First</a> : null}
            {page.url.prev ? <a href={page.url.prev}>Previous</a> : null}
          </div>
          <div>
            Page {page.currentPage} of {page.lastPage}
          </div>
          <div>
            {page.url.next ? <a href={page.url.next}>Next</a> : null}
            {page.url.last ? <a href={page.url.last}>Last</a> : null}
          </div>
        </nav>
    </Contents>
</Layout>

<style>
  ul {
    padding: 0;
  }

  li {
    list-style: none;
    margin-bottom: 1rem;
  }

  a {
    text-decoration: none;
    color: var(--color);
  }

  .button {
    border-left: 1px solid var(--color);
    padding: 0.5rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .button img {
    margin: -0.5rem -1rem -0.5rem 1rem;
    height: 9rem;
    width: 9rem;
    border: 1px solid var(--color);
    border-radius: 1rem;
  }

  h2 {
    margin-bottom: 0;
    margin-top: 0.4rem;
  }

  p {
    margin-top: 0.2rem;
    margin-bottom: 0.2rem;
  }

  nav {
    width: 100%;
    margin-top: 2rem;

    display: grid;
    grid-template-columns: 1fr auto 1fr;

    font-family: var(--font-sans);
  }

  nav a {
    border: 1px solid var(--color);
    padding: 0.5rem 1rem;
  }

  nav :first-child {
    justify-self: start;
  }

  nav :last-child{
    justify-self: end;
  }

</style>
